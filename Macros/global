Sub Extract_Tables_From_Doc()
    Dim fd As fileDialog
    Dim selectedFile As String
    Dim sourceDoc As Document
    Dim targetDoc As Document
    Dim tbl As Table
    Dim savePath As String
    Dim i As Long
    
    ' Ask user to select a Word document
    Set fd = Application.fileDialog(msoFileDialogFilePicker)
    fd.Title = "Select a Word Document"
    fd.Filters.Clear
    fd.Filters.Add "Word Documents", "*.docx; *.docm; *.doc"
    
    If fd.Show <> -1 Then Exit Sub ' user cancelled
    selectedFile = fd.SelectedItems(1)
    
    ' Open the selected document (read-only)
    Set sourceDoc = Documents.Open(selectedFile, ReadOnly:=True)
    
    ' Create a new document for tables
    Set targetDoc = Documents.Add
    
    ' Copy each table
    For i = 1 To sourceDoc.Tables.Count
        sourceDoc.Tables(i).Range.Copy
        targetDoc.Range(targetDoc.Content.End - 1).Paste
        targetDoc.Range.InsertParagraphAfter
        targetDoc.Range.InsertParagraphAfter
    Next i
    
    ' Build save path in same folder as source
    savePath = Left(selectedFile, InStrRev(selectedFile, "\")) & "Tables.docx"
    
    ' Save the new document
    targetDoc.SaveAs2 savePath, FileFormat:=wdFormatXMLDocument
    targetDoc.Close
    sourceDoc.Close SaveChanges:=False
    
    MsgBox "All tables have been extracted and saved as:" & vbCrLf & savePath, vbInformation
End Sub

