Sub CompileData()
    On Error GoTo ErrHandler

    Dim xmlDoc As Object
    Set xmlDoc = CreateObject("MSXML2.DOMDocument.6.0")
    xmlDoc.Async = False
    xmlDoc.ValidateOnParse = False

    Dim targetDoc As Document
    Set targetDoc = ActiveDocument

    Dim filePath As String
    filePath = GetSelectedFilePath()
    If filePath = "" Then
        MsgBox "No file selected.", vbExclamation
        Exit Sub
    End If

    If Not xmlDoc.Load(filePath) Then
        MsgBox "Failed to load XML file.", vbCritical
        Exit Sub
    End If

    ' Replace single node placeholders
    ReplaceTag targetDoc, "<running_title>", GetNodeText(xmlDoc, "//article/running_title")
    ReplaceTag targetDoc, "<article_type>", GetNodeText(xmlDoc, "//article/article_type")
    ReplaceTag targetDoc, "<article_title>", GetNodeText(xmlDoc, "//article/article_title")
    ReplaceTag targetDoc, "<submission_date>", GetNodeText(xmlDoc, "//article/submission_date")
    ReplaceTag targetDoc, "<accepted_date>", GetNodeText(xmlDoc, "//article/accepted_date")
    ReplaceTag targetDoc, "<DOI>", GetNodeText(xmlDoc, "//article/DOI")
    ReplaceTag targetDoc, "<patient_consent>", GetNodeText(xmlDoc, "//article/patient_consent")
    ReplaceTag targetDoc, "<source_of_support>", GetNodeText(xmlDoc, "//article/source_of_support")
    ReplaceTag targetDoc, "<conflict_of_interest>", GetNodeText(xmlDoc, "//article/conflict_of_interest")
    ReplaceTag targetDoc, "<ethical_approval>", GetNodeText(xmlDoc, "//article/ethical_approval")

    ' Insert AI declaration
    InsertBlockContent targetDoc, "<ai_declaration>", GetNodeText(xmlDoc, "//article/AI_Declaration")

    ' Build authors and affiliations
    Dim authorsList As String, affiliationsList As String
    Dim correspondingAuthorInfo As String
'    Dim uniqueAffiliations As New Collection
    BuildAuthorsAndAffiliations xmlDoc, authorsList, affiliationsList, correspondingAuthorInfo

    ReplaceTag targetDoc, "<authors>", authorsList
    InsertBlockContent targetDoc, "<affiliations>", affiliationsList
    ReplaceTag targetDoc, "<corresponding_author>", correspondingAuthorInfo
'    Call InsertAffiliationsWithSuperscript(targetDoc, "<affiliations>", uniqueAffiliations)


    ' Insert main document content
    filePath = GetSelectedFilePath()
    If filePath <> "" Then
        InsertFileContentAtTag targetDoc, "<document>", filePath
    End If

    ' Insert images
    Call InsertArticleCitation(xmlDoc, targetDoc)
'    InsertMultipleImagesWithDialog
'    InsertImagesBeforeFigureDescriptions

    MsgBox "Content insertion complete!"
    Exit Sub

ErrHandler:
    MsgBox "An error occurred: " & Err.Description, vbCritical
End Sub

'===============================
' Utility: Replace inline tag with text
'===============================
Sub ReplaceTag(doc As Document, tag As String, replacement As String)
    If replacement = "" Then replacement = "-"
    With doc.content.Find
        .text = tag
        .replacement.text = replacement
        .Execute Replace:=wdReplaceAll
    End With
End Sub

'===============================
' Utility: Insert multiline content (e.g., AI declaration, affiliations)
'===============================
Sub InsertBlockContent(doc As Document, tag As String, content As String)
    Dim para As Paragraph, rng As Range
    For Each para In doc.Paragraphs
        If InStr(para.Range.text, tag) > 0 Then
            Set rng = para.Range
            rng.Find.Execute FindText:=tag, ReplaceWith:=""
            rng.text = content
            Exit For
        End If
    Next para
End Sub

'===============================
' Utility: Load node text safely
'===============================
Function GetNodeText(xmlDoc As Object, xpath As String) As String
    On Error Resume Next
    GetNodeText = xmlDoc.SelectSingleNode(xpath).text
    If Err.Number <> 0 Then GetNodeText = ""
    On Error GoTo 0
End Function

'===============================
' Utility: Build authors and affiliations
'===============================
Sub BuildAuthorsAndAffiliations(xmlDoc As Object, ByRef authorsList As String, ByRef affiliationsList As String, ByRef correspondingAuthorInfo As String)
    Dim authorNodes As Object, author As Object
    Dim authorName As String, affiliation As String
    Dim uniqueAffiliations As New Collection
    Dim i As Integer
    Dim tempDoc As Document
    Dim rngStart As Range, rngNumber As Range

    Set authorNodes = xmlDoc.getElementsByTagName("author")
    authorsList = ""
    correspondingAuthorInfo = ""

    ' Build comma-separated author names
    For Each author In authorNodes
        On Error Resume Next
        authorName = Join(Filter(Array( _
            GetSafe(author, "fname"), _
            GetSafe(author, "mname"), _
            GetSafe(author, "lname")), ""), " ")

        If authorsList = "" Then
            authorsList = authorName
        Else
            authorsList = authorsList & ", " & authorName
        End If

        affiliation = Join(Array( _
            GetSafe(author, "department"), _
            GetSafe(author, "institute"), _
            GetSafe(author, "address"), _
            GetSafe(author, "city"), _
            GetSafe(author, "zip"), _
            GetSafe(author, "state"), _
            GetSafe(author, "country")), ", ")

        On Error Resume Next
        uniqueAffiliations.Add affiliation, affiliation
        On Error GoTo 0
        
        isCorresponding = GetSafe(author, "corresponding")
        If LCase(isCorresponding) = "yes" Then
            Email = GetSafe(author, "email")
            correspondingAuthorInfo = authorName & ", " & affiliation & ", " & Email
        End If
    Next author

    ' Use temp doc to insert and format correctly
    Set tempDoc = Documents.Add(Visible:=False)

    For i = 1 To uniqueAffiliations.Count
        Set rngStart = tempDoc.content
        rngStart.Collapse Direction:=wdCollapseEnd

        ' Insert number
        rngStart.InsertAfter CStr(i)

        ' Set range to the number just inserted
        Set rngNumber = tempDoc.Range(rngStart.Start, rngStart.Start + Len(CStr(i)))
        rngNumber.Font.Superscript = True

        ' Insert the affiliation text directly after the number
        rngNumber.Collapse Direction:=wdCollapseEnd
        rngNumber.InsertAfter uniqueAffiliations(i) & vbCrLf
    Next i

    affiliationsList = tempDoc.content.text
    tempDoc.Close SaveChanges:=False
End Sub
Sub InsertAffiliationsWithSuperscript(doc As Document, tag As String, uniqueAffiliations As Collection)
    Dim para As Paragraph, rng As Range
    Dim i As Integer

    For Each para In doc.Paragraphs
        If InStr(para.Range.text, tag) > 0 Then
            Set rng = para.Range
            rng.Find.Execute FindText:=tag, ReplaceWith:=""
            rng.Delete ' Remove tag placeholder

            For i = 1 To uniqueAffiliations.Count
                ' Insert superscript number
                rng.InsertAfter CStr(i)
                rng.MoveEnd wdCharacter, -Len(CStr(i))
                rng.Font.Superscript = True

                ' Insert affiliation text
                rng.Collapse Direction:=wdCollapseEnd
                rng.Font.Superscript = False
                rng.InsertAfter uniqueAffiliations(i) & vbCrLf
                rng.Collapse Direction:=wdCollapseEnd
            Next i
            Exit For
        End If
    Next para
End Sub
Sub InsertArticleCitation(xmlDoc As Object, doc As Document)
    Dim authorNodes As Object, author As Object
    Dim citationAuthors As String, citationLine As String
    Dim title As String, doi As String
    Dim fname As String, mname As String, lname As String
    Dim initials As String

    Set authorNodes = xmlDoc.getElementsByTagName("author")
    citationAuthors = ""

    For Each author In authorNodes
        fname = Trim(GetSafe(author, "fname"))
        mname = Trim(GetSafe(author, "mname"))
        lname = Trim(GetSafe(author, "lname"))

        initials = ""
        If fname <> "" Then initials = initials & UCase(Left(fname, 1))
        If mname <> "" Then initials = initials & UCase(Left(mname, 1))

        If citationAuthors = "" Then
            citationAuthors = lname & " " & initials
        Else
            citationAuthors = citationAuthors & ", " & lname & " " & initials
        End If
    Next author

    title = GetNodeText(xmlDoc, "//article/article_title")
    doi = GetNodeText(xmlDoc, "//article/DOI")

    citationLine = citationAuthors & ". " & title & ". doi: " & doi

    ' Replace in document
    Call InsertBlockContent(doc, "<article_citation>", citationLine)
End Sub


'===============================
' Utility: Get child text safely
'===============================
Function GetSafe(parent As Object, tagName As String) As String
    On Error Resume Next
    GetSafe = parent.SelectSingleNode(tagName).text
    If Err.Number <> 0 Then GetSafe = ""
    On Error GoTo 0
End Function

'===============================
' Utility: Insert full file at tag
'===============================
Sub InsertFileContentAtTag(doc As Document, tag As String, filePath As String)
    Dim para As Paragraph, rng As Range
    Dim tempDoc As Document

    Set tempDoc = Documents.Open(filePath, Visible:=False)
    tempDoc.content.Copy

    For Each para In doc.Paragraphs
        If InStr(para.Range.text, tag) > 0 Then
            Set rng = para.Range
            rng.Find.Execute FindText:=tag, ReplaceWith:=""
            rng.PasteAndFormat (wdFormatOriginalFormatting)
            Exit For
        End If
    Next para
    tempDoc.Close SaveChanges:=False
End Sub


