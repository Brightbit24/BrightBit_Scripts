    Set rng = ActiveDocument.content
    
    ' Remove highlighting by setting it to 'wdNoHighlight'
    rng.HighlightColorIndex = wdNoHighlight
    
    MsgBox "All highlighting has been removed.", vbInformation
End Sub
 
 Sub SortKeywordsPreserveLabelAndFont()
    Dim para As Paragraph
    Dim paraText As String
    Dim keywordPrefix As String
    Dim keywordPart As String
    Dim keywords() As String
    Dim i As Long, j As Long
    Dim temp As String
    Dim fullRange As Range
    Dim labelRange As Range
    Dim keywordRange As Range
    Dim labelLength As Long
    Dim paraFontName As String
    Dim paraFontSize As Single

    keywordPrefix = "Keywords:"
    
    ' Loop through paragraphs to find "Keywords:"
    For Each para In ActiveDocument.Paragraphs
        paraText = Trim(para.Range.text)
        
        If LCase(Left(paraText, Len(keywordPrefix))) = LCase(keywordPrefix) Then
            ' Get the range excluding the paragraph mark
            Set fullRange = para.Range
            fullRange.End = fullRange.End - 1
            
            ' Save the paragraph font info
            paraFontName = fullRange.Font.Name
            paraFontSize = fullRange.Font.Size
            
            ' Extract and process keywords
            keywordPart = Trim(Mid(paraText, Len(keywordPrefix) + 1))
            keywords = Split(keywordPart, ",")
            
            For i = 0 To UBound(keywords)
                keywords(i) = Trim(keywords(i))
            Next i
            
            ' Sort keywords alphabetically
            For i = 0 To UBound(keywords) - 1
                For j = i + 1 To UBound(keywords)
                    If StrComp(keywords(i), keywords(j), vbTextCompare) > 0 Then
                        temp = keywords(i)
                        keywords(i) = keywords(j)
                        keywords(j) = temp
                    End If
                Next j
            Next i
            
            ' Build sorted keyword string
            Dim sortedKeywordText As String
            sortedKeywordText = " " & Join(keywords, ", ")
            
            ' Define ranges for label and keyword
            labelLength = Len(keywordPrefix)
            Set labelRange = fullRange.Duplicate
            labelRange.End = labelRange.Start + labelLength
            
            Set keywordRange = fullRange.Duplicate
            keywordRange.Start = labelRange.End
            
            ' Replace keywords, keep font
            keywordRange.text = sortedKeywordText
            keywordRange.Font.Reset
            keywordRange.Font.Bold = False
            keywordRange.Font.Name = paraFontName
            keywordRange.Font.Size = paraFontSize
            
            MsgBox "Keywords sorted. Formatting preserved.", vbInformation
            Exit Sub
        End If
    Next para

    MsgBox "No paragraph starting with 'Keywords:' found.", vbExclamation
End Sub
Sub MoveCitationsAfterSymbolsAndRemoveSpace()
    Dim para As Paragraph
    Dim re As Object
    Dim matches As Object
    Dim match As Object
    Dim citationText As String
    Dim rngReplace As Range
    Dim symbol As String
    Dim citationLen As Long

    Set re = CreateObject("VBScript.RegExp")
    re.Global = True
    re.IgnoreCase = False

    ' Match pattern: [1], [2;3] etc. with optional space before and a special symbol after (but [1] must come before symbol)
    ' Captures: citation (group 1), symbol (group 3)
    re.Pattern = "\s*(\[(\s*\d+[\s,;&]*\d*\s*)+\])(\s*)([.,:;!?])"

    For Each para In ActiveDocument.Paragraphs
        Dim paraText As String
        paraText = para.Range.text

        If re.Test(paraText) Then
            Set matches = re.Execute(paraText)

            Dim i As Long
            For i = matches.Count - 1 To 0 Step -1
                Set match = matches(i)
                citationText = match.SubMatches(0) ' full [1], [2;3]
                symbol = match.SubMatches(3)       ' the punctuation mark (e.g., . or ,)

                Dim totalMatchStart As Long
                totalMatchStart = para.Range.Start + match.FirstIndex
                citationLen = Len(citationText)

                ' Replace: [x] <space> symbol  --> symbol[citation]
                Set rngReplace = ActiveDocument.Range( _
                    Start:=totalMatchStart, _
                    End:=totalMatchStart + Len(match.Value))

                rngReplace.text = symbol & citationText

                MsgBox rngReplace.text
                
                ' Apply superscript only to citation part (exclude the symbol)
                Set rngReplace = ActiveDocument.Range( _
                    Start:=totalMatchStart + 1, _
                    End:=totalMatchStart + 1 + citationLen)

                rngReplace.Font.Superscript = True
            Next i
        End If
    Next para

    MsgBox "Citations moved after punctuation and superscripted. Spaces before punctuation removed."
End Sub






Sub NormalizeFigureAndTableReferencesAccurately()
    Dim para As Paragraph
    Dim regEx As Object
    Dim matches As Object
    Dim matchItem As Object
    Dim matchStart As Long, matchLen As Long
    Dim matchRange As Range
    Dim referenceText As String
    Dim i As Long
    Dim originalText As String

    ' Create RegExp object
    Set regEx = CreateObject("VBScript.RegExp")
    regEx.Global = True
    regEx.IgnoreCase = False ' Preserve case of "Figure" or "Table"

    ' Match:
    ' (Figure 1), [Table 2], Figure 3, Table 4, etc.
    regEx.Pattern = "(\(Figure\s\d+(?:\s*,\s*\d+)*\)|\(figure\s\d+(?:\s*,\s*\d+)*\)|" & _
                    "\[Figure\s\d+(?:\s*,\s*\d+)*\]|\[figure\s\d+(?:\s*,\s*\d+)*\]|" & _
                    "\(Table\s\d+(?:\s*,\s*\d+)*\)|\(table\s\d+(?:\s*,\s*\d+)*\)|" & _
                    "\[Table\s\d+(?:\s*,\s*\d+)*\]|\[table\s\d+(?:\s*,\s*\d+)*\]|" & _
                    "Figure\s\d+(?:\s*,\s*\d+)*|figure\s\d+(?:\s*,\s*\d+)*|" & _
                    "Table\s\d+(?:\s*,\s*\d+)*|table\s\d+(?:\s*,\s*\d+)*)"

    For Each para In ActiveDocument.Paragraphs
        Set matches = regEx.Execute(para.Range.text)

        If matches.Count > 0 Then
            For i = matches.Count - 1 To 0 Step -1
                Set matchItem = matches(i)
                matchStart = matchItem.FirstIndex
                matchLen = matchItem.Length

                Set matchRange = para.Range.Duplicate
                matchRange.Start = para.Range.Start + matchStart
                matchRange.End = matchRange.Start + matchLen

                originalText = matchRange.text

                ' If wrapped in () or []
                If (Left(originalText, 1) = "(" And Right(originalText, 1) = ")") Or _
                   (Left(originalText, 1) = "[" And Right(originalText, 1) = "]") Then

                    referenceText = Mid(originalText, 2, Len(originalText) - 2) ' Strip () or []
                    matchRange.text = "[" & Trim(referenceText) & "]"
                    matchRange.Font.Bold = False

                Else
                    ' Only remove bold, keep text as-is
                    matchRange.Font.Bold = False
                End If
            Next i
        End If
    Next para

    MsgBox "Figure and Table references normalized and bold removed where needed."
End Sub


Sub ItalicizeEtAl()
    With ActiveDocument.content.Find
        .ClearFormatting
        .text = "et al"
        .MatchCase = False
        .MatchWholeWord = True
        .replacement.ClearFormatting
        .replacement.Font.Italic = True
        .replacement.text = "et al"
        .Execute Replace:=wdReplaceAll
    End With
    MsgBox """et al"" has been italicized throughout the document."
End Sub
Sub RemoveReferenceIssueNo()
    Dim para As Paragraph
    Dim inReferences As Boolean
    Dim re As Object
    Dim match As Object
    Dim paraRange As Range
    Dim rawText As String

    ' Create RegExp to match volume(issue): pattern
    Set re = CreateObject("VBScript.RegExp")
    re.Global = True
    re.IgnoreCase = True
    re.Pattern = "(\d+)\(\d+\):"  ' e.g., 91(2): ? 91:

    inReferences = False

    For Each para In ActiveDocument.Paragraphs
        rawText = Trim(Replace(para.Range.text, vbCr, ""))

        ' Start processing after "References"
        If LCase(rawText) = "references" Then
            inReferences = True
        ElseIf inReferences Then
            ' Skip empty lines
            If rawText = "" Then
                ' do nothing, stay in loop
            ElseIf para.Range.ListFormat.ListType = wdListSimpleNumbering Or _
                   para.Range.ListFormat.ListType = wdListNumberStyleArabic Then

                Set paraRange = para.Range.Duplicate

                ' Perform Find/Replace using RegExp matches
                If re.Test(paraRange.text) Then
                    For Each match In re.Execute(paraRange.text)
                        With paraRange.Find
                            .ClearFormatting
                            .text = match.Value
                            .replacement.text = re.Replace(match.Value, "$1:")
                            .Forward = True
                            .Wrap = wdFindStop
                            .Execute Replace:=wdReplaceAll
                        End With
                    Next match
                End If

            Else
                Exit For ' stop when references section ends
            End If
        End If
    Next para

    MsgBox "Issue numbers removed and numbering preserved.", vbInformation
End Sub
Sub InsertImagesAboveFigureLegends()
    Dim dlg As fileDialog
    Dim selectedImages() As String
    Dim para As Paragraph
    Dim figIndex As Integer
    Dim inserted As Integer
    Dim rng As Range
    Dim foundLegends As Boolean
    Dim paraText As String
    Dim i As Integer

    ' Prompt user to select images
    Set dlg = Application.fileDialog(msoFileDialogFilePicker)
    With dlg
        .title = "Select Images for Figures"
        .AllowMultiSelect = True
        .Filters.Clear
        .Filters.Add "Image Files", "*.jpg;*.jpeg;*.png;*.bmp;*.gif;*.tif;*.tiff"

        If .Show <> -1 Then
            MsgBox "No images selected.", vbInformation
            Exit Sub
        End If

        ReDim selectedImages(1 To .SelectedItems.Count)
        For i = 1 To .SelectedItems.Count
            selectedImages(i) = .SelectedItems(i)
        Next i
    End With
    
    figIndex = 1
    inserted = 0
    foundLegends = False
    For Each para In ActiveDocument.Paragraphs
        paraText = Trim(LCase(Replace(para.Range.text, vbCr, "")))

        If Not foundLegends Then
            If paraText = "legends of figures" Then
                foundLegends = True
            End If
            GoTo NextPara
        End If

        If paraText = "" Then GoTo NextPara

        If Left(paraText, 6) = "figure" Then
            If inserted < UBound(selectedImages) Then
                Set rng = para.Range
                rng.Collapse wdCollapseStart

                ' Insert the image
                ActiveDocument.InlineShapes.AddPicture _
                    FileName:=selectedImages(inserted + 1), _
                    LinkToFile:=False, _
                    SaveWithDocument:=True, _
                    Range:=rng

                ' Move cursor after image and add paragraph
                rng.Collapse wdCollapseEnd
                rng.InsertParagraphAfter

                inserted = inserted + 1
            End If
        Else
            Exit For
        End If

NextPara:
    Next para

    MsgBox inserted & " image(s) inserted above figure legends.", vbInformation
End Sub
Sub ConvertH1TextToTitleCase()
    Dim i As Long
    Dim para As Paragraph
    Dim fullText As String
    Dim tag As String
    Dim prefix As String
    Dim afterTag As String

    tag = "<H1>"

    ' Loop backwards to prevent reflow issues
    For i = ActiveDocument.Paragraphs.Count To 1 Step -1
        Set para = ActiveDocument.Paragraphs(i)
        fullText = Trim(para.Range.text)

        ' Check if paragraph starts with <H1>
        If LCase(Left(fullText, Len(tag))) = LCase(tag) Then
            prefix = Mid(fullText, 1, Len(tag)) ' Keep the <H1> tag
            afterTag = Mid(fullText, Len(tag) + 1) ' Text after <H1>
            afterTag = StrConv(Trim(afterTag), vbProperCase) ' Title Case

            ' Safely set updated text
            para.Range.text = prefix & " " & afterTag
        End If
    Next i

    MsgBox "Converted text after <H1> to Title Case.", vbInformation
End Sub
Sub ConvertToTimesNewRoman()
    With ActiveDocument.content.Font
        .Name = "Times New Roman"
    End With
    MsgBox "All text converted to Times New Roman.", vbInformation
End Sub
Sub RunAllDocumentMacros()
    On Error GoTo HandleError

    ' === Call each macro here ===
    Call RemoveAllHighlighting
    Call MoveSuperscriptCitationsAfterPeriodBlock
    Call ConvertToTimesNewRoman
    Call SortKeywordsPreserveLabelAndFont
    Call NormalizeFigureReferencesMultiple
    Call ConvertH1TextToTitleCase
    Call ItalicizeEtAl
    Call RemoveReferenceIssueNo
    Call InsertImagesAboveFigureLegends
    
    
    MsgBox "All macros ran successfully.", vbInformation
    Exit Sub

HandleError:
    MsgBox "Error during macro execution: " & Err.Description, vbCritical
End Sub
















