Private Sub InsertMultipleImagesWithDialog()
    Dim fileDialog As fileDialog
    Dim imageFiles As Variant
    Dim i As Integer
    Dim img As InlineShape
    Dim rng As Range
    Dim found As Boolean

    ' Search for the <images> tag in the document
    Set rng = ActiveDocument.content
    With rng.Find
        .text = "<images>"
        .MatchCase = False
        .MatchWholeWord = False
        .MatchWildcards = False
        .Wrap = wdFindStop
        If .Execute Then
            found = True
        End If
    End With

    If Not found Then
        MsgBox "No <images> tag found in the document.", vbExclamation
        Exit Sub
    End If

    ' Remove the <images> tag
    rng.Delete

    ' Open the File Dialog for selecting multiple images
    Set fileDialog = Application.fileDialog(msoFileDialogFilePicker)
    fileDialog.title = "Select Images"
    fileDialog.AllowMultiSelect = True ' Allow multiple selections
    fileDialog.Filters.Clear
    fileDialog.Filters.Add "Image Files", "*.jpg;*.jpeg;*.png;*.gif;*.bmp;*.tiff"

    ' Show the dialog box and check if the user selected files
    If fileDialog.Show = -1 Then
        ' Loop through each selected file and insert at the tag's location
        For i = 1 To fileDialog.SelectedItems.Count
            Set img = ActiveDocument.InlineShapes.AddPicture( _
                FileName:=fileDialog.SelectedItems(i), _
                LinkToFile:=False, _
                SaveWithDocument:=True, _
                Range:=rng)

            ' Move the range after the inserted image to prepare for next insert
            rng.SetRange Start:=img.Range.End, End:=img.Range.End
            rng.InsertParagraphAfter
            rng.Collapse wdCollapseEnd
        Next i
    Else
        MsgBox "No images selected.", vbInformation
    End If
End Sub

Private Function GetSelectedFilePath() As String
    Dim fileDialog As fileDialog

    Set fileDialog = Application.fileDialog(msoFileDialogOpen)
    
    ' Show the dialog box to the user
    If fileDialog.Show = -1 Then
        ' If the user selects a file, get the file path
        GetSelectedFilePath = fileDialog.SelectedItems(1)
        MsgBox "You selected: " & GetSelectedFilePath
    Else
        GetSelectedFilePath = ""
        MsgBox "No file was selected."
    End If
    
    
    ' Clean up
    Set fileDialog = Nothing
End Function

